# === CoBien Furniture Electron App ===
# Plantilla de Configuración.
# Copia este archivo a `.env` y rellena los secretos.

# Entorno de Ejecución
COBIEN_DEVICE_ID="CoBienX"
COBIEN_VIDEOCALL_ROOM="CoBienX"
COBIEN_DEVICE_LOCATION="Bilbao"
COBIEN_APP_LANGUAGE="es"

# Seguridad
COBIEN_SETTINGS_PIN="0008"
COBIEN_RESTART_PIN="8000"

# Hardware de Pantalla
COBIEN_DISPLAY_OUTPUT="eDP-1"
COBIEN_DISPLAY_MODE="1920x1200"
COBIEN_DISPLAY_ROTATION="inverted"

# === APIs y Servicios Externos ===
# MongoDB
MONGO_URI=""

# APIs de Terceros
OWM_API_KEY=""
NEWS_API_KEY=""

# Autenticación Backend CoBien
COBIEN_NOTIFY_API_KEY=""
NOTIFY_API_KEY=""
COBIEN_VIDEOCALL_DEVICE_API_KEY=""

# === Endpoints Backend ===
COBIEN_BACKEND_BASE_URL="https://portal.co-bien.eu"
COBIEN_DEVICE_POLL_URL="https://portal.co-bien.eu/pizarra/api/device/poll/"
COBIEN_DEVICE_POLL_INTERVAL_SEC="5"
COBIEN_DEVICE_HEARTBEAT_URL="https://portal.co-bien.eu/pizarra/api/devices/heartbeat/"
COBIEN_DEVICE_HEARTBEAT_INTERVAL_SEC="60"
COBIEN_PIZARRA_NOTIFY_URL="https://portal.co-bien.eu/pizarra/api/notify/"
COBIEN_PIZARRA_API_URL="https://portal.co-bien.eu/pizarra/api/messages/"
COBIEN_PIZARRA_DELETE_URL_TEMPLATE="https://portal.co-bien.eu/pizarra/api/messages/{post_id}/delete/"
COBIEN_CONTACTS_API_URL="https://portal.co-bien.eu/pizarra/api/contacts/"
COBIEN_ICSO_TELEMETRY_URL="https://portal.co-bien.eu/pizarra/api/icso/telemetry/"
COBIEN_ICSO_EVENTS_URL="https://portal.co-bien.eu/pizarra/api/icso/events/"
COBIEN_DEVICE_VIDEOCALL_SESSION_URL="https://portal.co-bien.eu/api/device-videocall-session/"
COBIEN_PORTAL_VIDEOCALL_URL="https://portal.co-bien.eu/videocall/"
COBIEN_PORTAL_VIDEOCALL_DEVICE_URL="https://portal.co-bien.eu/videocall/device/"
COBIEN_PORTAL_CALL_ANSWERED_URL="https://portal.co-bien.eu/api/call-answered/"

# Endpoints Terceros
COBIEN_OPENWEATHER_CURRENT_URL="https://api.openweathermap.org/data/2.5/weather"
COBIEN_OPENWEATHER_FORECAST_URL="https://api.openweathermap.org/data/2.5/forecast"
COBIEN_NEWS_API_URL="https://newsapi.org/v2/top-headlines"
COBIEN_OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
COBIEN_NOMINATIM_SEARCH_URL="https://nominatim.openstreetmap.org/search"

# === MQTT Local (Sensores/Actuadores) ===
COBIEN_MQTT_LOCAL_BROKER="localhost"
COBIEN_MQTT_LOCAL_PORT="1883"

# === Text-to-Speech (TTS) ===
COBIEN_TTS_ENGINE="piper"
COBIEN_TTS_PIPER_VOICE_ES="male"
COBIEN_TTS_PIPER_VOICE_FR="male"
